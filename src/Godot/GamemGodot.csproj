<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0</TargetFrameworks>
    <RootNamespace>Gamem.Godot</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Version>1.0.0-debug</Version>
    <Title>Gamem</Title>
    <Authors>nicky_sus</Authors>
    <Description>Gamem extension for Godot (supports vectors)</Description>
    <PackageReleaseNotes>
      1.0.0 is out!
      Check the full changelog on GitHub!
      https://github.com/nicky-suss/Gamem/releases
    </PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <RepositoryUrl>https://github.com/nicky-suss/Gamem</RepositoryUrl>
    <PackageTags>gamedev;game-development;physics;math;collision;geometry;godot;utilities;lightweight</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>logo.png</PackageIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Gamem" Version="2.0.0" />
    <PackageReference Include="GodotSharp" Version="4.6.3" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="images/logo.png" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
